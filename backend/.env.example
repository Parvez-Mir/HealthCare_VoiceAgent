# LLM provider: ollama, openai, google, or anthropic.
LLM_PROVIDER=ollama
LLM_MODEL=hf.co/LiquidAI/LFM2.5-1.2B-Instruct-GGUF:Q8_0
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=

# Legacy Ollama names are still accepted for backwards compatibility.
OLLAMA_MODEL=hf.co/LiquidAI/LFM2.5-1.2B-Instruct-GGUF:Q8_0
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
ASSEMBLYAI_API_KEY=
CARTESIA_API_KEY=
# Optional; defaults to Fiona
CARTESIA_VOICE_ID=
# Prompt ID from agent_prompts.json
AGENT_PROMPT_ID=flora-healthcare-agent-v1

# Required when connecting the agent to LiveKit.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Outbound calling: LiveKit outbound SIP trunk ID (starts with ST_).
SIP_OUTBOUND_TRUNK_ID=

# Opik for post analysis online evaluation
OPIK_API_KEY=opik
OPIK_WORKSPACE=your-workspace
OPIK_PROJECT_NAME=healthcare-voice-agent