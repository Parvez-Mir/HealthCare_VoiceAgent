# Local Ollama model exposed through its OpenAI-compatible API.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
ASSEMBLYAI_API_KEY=
CARTESIA_API_KEY=
